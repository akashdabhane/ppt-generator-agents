# Copy to backend/.env and fill in. Values starting with "your_" (or ending in "_here") are treated as unset.

# Runtime: "development" allows the insecure default SECRET_KEY (with a warning); any other value refuses to start without one
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_secret_key_here
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppt_generator_db

# Redis & Celery (the API falls back to in-process jobs when Redis is down)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector DB: "pinecone", "pgvector" or "mock" (in-memory, lost on restart)
VECTOR_DB_TYPE=pinecone

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ppt-generator-rag

# PGVector Configuration (used when VECTOR_DB_TYPE=pgvector)
PGVECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppt_generator_db

# LLM provider: anthropic | openai | google
LLM_PROVIDER=google
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# Optional model override (defaults: anthropic=claude-sonnet-5, openai=gpt-4o, google=gemini-2.5-flash)
LLM_MODEL=

# Embeddings: auto | openai | google | hash
# "auto" = OpenAI if its key is set, else Google, else hash vectors (no semantic search). Chosen once and never mixed.
EMBEDDING_PROVIDER=auto
# Optional (defaults: openai=text-embedding-3-small, google=gemini-embedding-001)
EMBEDDING_MODEL=
# Must equal the vector index dimension (Pinecone index / pgvector column). Changing it needs a new index + re-index.
EMBEDDING_DIMENSION=1536

# Frontend API URL (used by the Next.js app; set it in frontend/.env.local for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
