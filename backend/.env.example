# Database & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppt_generator_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppt_generator_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector DB ("pinecone", "pgvector", "qdrant", or "mock")
# Set to "pinecone" for default production vector search, or "pgvector" if using PostgreSQL vector extension
VECTOR_DB_TYPE=pinecone

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ppt-generator-rag

# PGVector Configuration (Used when VECTOR_DB_TYPE=pgvector)
PGVECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppt_generator_db

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Providers
LLM_PROVIDER=google # "anthropic", "openai", or "google"
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# Optional model override (defaults: anthropic=claude-sonnet-5, openai=gpt-4o, google=gemini-2.5-flash)
LLM_MODEL=

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

